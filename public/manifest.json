{
  "short_name": "DM ARRANGIA",
  "name": "DM ARRANGIA",
  "description": "DM ARRANGIA is a professional keyboard and worship studio for musicians, performers and creators.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": ["music", "entertainment", "productivity", "utilities"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "48x48 72x72 96x96 128x128 192x192 256x256 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "32x32",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Styles Browser",
      "short_name": "Styles",
      "description": "Browse and load Yamaha .STY accompaniment styles",
      "url": "/?action=styles",
      "icons": [{ "src": "/favicon.svg", "sizes": "32x32" }]
    },
    {
      "name": "Chord Sequencer",
      "short_name": "Sequencer",
      "description": "Build and arrange chord progressions",
      "url": "/?action=sequencer",
      "icons": [{ "src": "/favicon.svg", "sizes": "32x32" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/?mode=workstation",
      "name": "Yamaha Style File (.sty, .prs, .sst, .bcs, .mid)",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-yamaha-style": [".sty", ".prs", ".sst", ".bcs"],
        "audio/midi": [".mid", ".midi"],
        "application/octet-stream": [".sty", ".prs", ".sst", ".bcs", ".mid", ".midi"]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/?mode=media_player",
      "name": "Audio & Video Media Files (.mp3, .mp4, .wav, .mkv, .flac...)",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".oga"],
        "audio/flac": [".flac"],
        "audio/mp4": [".m4a", ".aac"],
        "audio/x-ms-wma": [".wma"],
        "video/mp4": [".mp4", ".m4v"],
        "video/x-matroska": [".mkv"],
        "video/webm": [".webm"],
        "video/x-msvideo": [".avi"],
        "video/quicktime": [".mov"],
        "video/x-flv": [".flv"],
        "application/octet-stream": [
          ".mp3",
          ".mp4",
          ".wav",
          ".mkv",
          ".flac",
          ".ogg",
          ".m4a",
          ".aac",
          ".wma",
          ".avi",
          ".mov",
          ".webm"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
