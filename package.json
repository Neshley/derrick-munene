{
  "name": "dm-arrangia",
  "productName": "DM ARRANGIA",
  "description": "DM ARRANGIA is a professional keyboard and worship studio for musicians, performers and creators.",
  "author": "Derrick Munene",
  "private": true,
  "version": "2.5.0",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "vite build",
    "desktop:dist": "npm run desktop:build && electron-builder --dir",
    "desktop:dist:dir": "npm run desktop:build && electron-builder --dir",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win",
    "desktop:dist:mac": "npm run desktop:build && electron-builder --mac",
    "desktop:dist:linux": "npm run desktop:build && electron-builder --linux",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
